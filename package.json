{
  "name": "creactors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "fonts": "node scripts/prepare-fonts.mjs",
    "build": "npm run typecheck && vite build && node scripts/check-build.mjs",
    "build:static": "npm run build && node scripts/build-static.mjs",
    "test:offline": "node scripts/check-static-offline.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@giphy/js-fetch-api": "5.8.0",
    "franc": "6.2.0",
    "gifuct-js": "2.1.2",
    "mediabunny": "1.61.3",
    "opentype.js": "2.0.0",
    "three": "0.186.1",
    "troika-three-text": "0.52.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
